{
  "config.providers": "file",
  "config.providers.file.class": "org.apache.kafka.common.config.provider.FileConfigProvider",
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "${file:/config/secrets.properties:postgres.user}",
  "database.password": "${file:/config/secrets.properties:postgres.password}",
  "database.dbname": "app",
  "database.server.name": "dbserver1",
  "table.include.list": "public.user_profile",
  "plugin.name": "pgoutput",
  "slot.name": "debezium_slot",
  "publication.autocreate.mode": "filtered",
  "topic.prefix": "cdc",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "unwrap,addSchemaVersion",
  "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
  "transforms.unwrap.drop.tombstones": "true",
  "transforms.unwrap.delete.handling.mode": "rewrite",
  "transforms.addSchemaVersion.type": "org.apache.kafka.connect.transforms.InsertField$Value",
  "transforms.addSchemaVersion.static.field": "schema_version",
  "transforms.addSchemaVersion.static.value": "v1",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
  "schema.history.internal.kafka.topic": "schema-changes.cdc"
}
