# Webhook for real-time alerts
ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=replace_me

# Optional API source
SOURCE_API_URL=https://example.com/events
SOURCE_API_TOKEN=replace_me

# Kafka producer defaults
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=user_behavior_events
RAG_TOPIC=rag_raw_documents
TOPIC_NAMESPACE=
TENANT_ID=tenant_demo
PRODUCER_SLEEP_SECONDS=0.5
COLLECTOR_MODE=http
HTTP_PORT=8088

# Data-enrich defaults
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents
EMBEDDING_DIM=128
EMBEDDING_PROVIDER=simple
OPENAI_API_KEY=

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8086

# Metrics exporter defaults
METRICS_PORT=9108
UV_WINDOW_SECONDS=300
KAFKA_EVENT_TOPIC=user_behavior_events
KAFKA_METRIC_TOPIC=realtime_stats_metrics

# PostgreSQL credentials (Item 3)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=app

# Grafana admin credentials (Item 4)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme_in_production

# Elasticsearch security (Item 2)
ES_SECURITY_ENABLED=false

# Kafka SASL (Item 1 - production only)
# KAFKA_SASL_ENABLED=false
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# Qdrant API key (Item 5 - production only)
# QDRANT_API_KEY=
